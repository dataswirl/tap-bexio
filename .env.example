# Either a Personal Access Token ...
TAP_BEXIO_AUTH_TOKEN=
# ... or OAuth (get the refresh token with `uv run tap-bexio-auth`)
TAP_BEXIO_CLIENT_ID=
TAP_BEXIO_CLIENT_SECRET=
TAP_BEXIO_REFRESH_TOKEN=

# Optional settings: uncomment to override. An empty value is still read,
# so leave a setting commented out to use its default.
#TAP_BEXIO_OAUTH_TOKEN_URL=https://auth.bexio.com/realms/bexio/protocol/openid-connect/token
#TAP_BEXIO_START_DATE=2024-01-01
#TAP_BEXIO_API_URL=https://api.bexio.com
#TAP_BEXIO_USER_AGENT=tap-bexio (you@example.com)
#TAP_BEXIO_PAGE_SIZE=500
#TAP_BEXIO_TIMEZONE=Europe/Zurich
#TAP_BEXIO_OUTPUT_TIMEZONE=UTC
# skip | fail
#TAP_BEXIO_FORBIDDEN_STREAM_BEHAVIOR=skip
